# ── IVDAF Environment Configuration ───────────────────────────────────────────
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev, zero-config — default):
DATABASE_URL=sqlite+aiosqlite:///./vuln_scanner.db

# PostgreSQL (prod — uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://scanner:CHANGE-ME@localhost:5432/vulnscanner

# ── Postgres container credentials (docker-compose only) ──────────────────────
# If the database URL above uses postgres, also set these so the postgres
# service uses matching credentials. Default is insecure (scanner:scanner).
POSTGRES_USER=scanner
POSTGRES_PASSWORD=scanner
POSTGRES_DB=vulnscanner

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Production deployments: treat Redis + Celery as MANDATORY.
# /health/full reports 'unhealthy' (not 'degraded') when they are down.
# Set false for single-host lab use; the asyncio fallback handles scans.
REDIS_REQUIRED=true

# When true, /health/full returns HTTP 503 (not 200) when subsystems are
# unhealthy. Required for Kubernetes readiness probes / ALB target health.
REDIS_REQUIRED_RETURNS_503=true

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-use-a-long-random-string-in-production

# Only honour X-Forwarded-For when behind a known reverse proxy.
# Leave as false otherwise — header spoofing trivially bypasses rate limit.
TRUST_PROXY_HEADERS=false

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://frontend:8501

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ── Scanning ──────────────────────────────────────────────────────────────────
SCAN_TIMEOUT=30
MAX_CONCURRENT_SCANS=5
DEFAULT_PORT_RANGE=1-1024

# Inside a Docker container that has been granted CAP_NET_RAW on the nmap
# binary via `setcap`, set this to true so the scanner uses SYN / OS scan
# flags rather than downgrading to TCP-connect.
# NMAP_PRIVILEGED=true

# ── Storage ───────────────────────────────────────────────────────────────────
REPORTS_DIR=./reports
LOGS_DIR=./logs
LOG_FILE=./logs/vuln_scanner.log

# ── Streamlit dashboard ───────────────────────────────────────────────────────
# Backend URL the frontend should talk to. Inside docker-compose use the
# service name (http://backend:8000); standalone defaults to localhost.
API_BASE_URL=http://localhost:8000

# ── Flower (Celery monitor) basic auth ────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=admin
